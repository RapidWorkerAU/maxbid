{
  "name": "maxbid",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@maxbid/web",
    "dev:app": "turbo run dev --filter=@maxbid/app",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "pnpm --filter @maxbid/storybook storybook",
    "check:size": "node scripts/check-file-size.mjs",
    "check": "pnpm check:size && pnpm check:tags && pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "e2e": "playwright test",
    "check:tags": "node scripts/check-story-tags.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.8",
    "supabase": "^2.117.0",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.8",
      "react-dom": "19.2.8"
    }
  }
}
