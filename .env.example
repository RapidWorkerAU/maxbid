# MaxBid environment variables. Copy to apps/web/.env.local and apps/app/.env.local
# and fill in the values. Never commit real keys.

# Supabase (Settings, API Keys). Older projects call these the anon and service_role keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Site URLs
NEXT_PUBLIC_SITE_URL=https://maxbid.com.au
NEXT_PUBLIC_APP_URL=https://app.maxbid.com.au

# Anthropic Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# Background jobs. Inngest, chosen by decision record 0013.
# Not needed for local work: the Inngest Dev Server runs without them.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Page extraction. Open item O02: choose Firecrawl or Browserbase.
FIRECRAWL_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Web search. Open item O03: choose Brave Search or SerpAPI.
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# eBay developer program (Browse API, and Marketplace Insights once approved, O04)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Road distance for transport estimates. Choose Google Routes or Mapbox.
GOOGLE_ROUTES_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Email (resend.com)
RESEND_API_KEY=

# Monitoring and analytics
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Payments (phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
